# Ghar Bhet: every variable is optional. The app starts with no .env file and no keys.
# Copy to .env only if you want to change a default.

# Port the server listens on (docker compose maps it to 8080)
PORT=8080

# Folder for the village register (one JSON file)
DATA_DIR=./data

# Set to 1 to allow POST /api/reset (used by the browser voice tests only)
ALLOW_RESET=

# Set to 1 so every browser sees one shared register (a village laptop or pilot).
# Leave empty for the public demo, where each browser sees the sample village plus its own saves.
SHARED_BOARD=

# Clear visitors' saves after this many hours (0 = never). Default: 6 on Cloud Run, off elsewhere.
DEMO_TTL_HOURS=

# Caps that keep a public demo from growing without bound
MAX_PEOPLE=300
MAX_VISITS=2000

# Optional Google Cloud Storage backup of the register (no key needed on Cloud Run;
# the server uses the runtime service account). Leave empty to use the local file only.
GCS_BUCKET=
GCS_OBJECT=register.json
GCS_DEBOUNCE_MS=1500
GCS_MAX_WRITES_PER_DAY=120
# For testing GCS from your own machine only: a short-lived OAuth token (never commit one)
GCS_TOKEN=

# Number of proxy hops in front of the server (for the rate limiter), e.g. 1 behind Cloud Run
TRUST_PROXY=
