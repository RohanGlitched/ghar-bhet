{"id":"nb-026","lang":"hi","script":"roman","said":"baby ka weight janam pe 2 kilo bataya tha, aaj 1 kilo 750 gram aaya. Komal ka baby, ikkisva din. Doodh theek pee raha.","record":{"type":"newborn","name":"Komal","day":21,"weight_g":1750,"feeding":"good"},"flags":["nb_very_low_weight"],"tags":["distractor-number","numbers-digits"]}
