{"id":"h-nb-021","lang":"mr","script":"devanagari","said":"बाळ फक्त हात लावला तरच हलतं, रडणं कमी, जुलाब पण होतायत. अनुराधाचं बाळ, सहावा दिवस, वजन दोन किलो.","record":{"type":"newborn","name":"Anuradha","day":6,"weight_g":2000,"symptoms":{"lethargy":true,"weak_cry":true,"diarrhoea":true}},"flags":["nb_diarrhoea","nb_lethargy","nb_low_weight","nb_sepsis_signs","nb_weak_cry"],"tags":["multi-sign","local-idiom"]}
